{
  "name": "transparent-pad",
  "version": "1.0.0",
  "description": "Transparent overlay pad",
  "author": "aaa",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "node api.js && electron .",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.transparent.pad",
    "productName": "TransparentPad",
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    }
  }
}
